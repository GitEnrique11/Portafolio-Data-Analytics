# Visualizar Dataset
head(Credit_card_Fraud)
library(readr)
Credit_card_Fraud <- read_csv("~/Kike/Portafolio-Data-Analytics/casoDeNegocio_Credito/dataset_Original/Credit card Fraud.csv")
View(Credit_card_Fraud)
# Visualizar Dataset
head(Credit_card_Fraud)
summary(Credit_card_Fraud)
str(Credit_card_Fraud)
# Cambiar a Factor la columna Class
Credit_card_Fraud$Class <- as.factor(Credit_card_Fraud$Class)
# Dividir los datos en Entrenamiento y Prueba
library(caret)
set.seed(123)
trainIndex <- createDataPartition(Credit_card_Fraud$Class, p=0.7, list=FALSE)
trainData <- Credit_card_Fraud[trainIndex, ]
testData  <- Credit_card_Fraud[-trainIndex, ]
# Modelo predictivo
modelo_logit_full <- glm(Class ~ .,
data=trainData,
family=binomial)
summary(modelo_logit_full)
# Predicciones
predicciones_full <- predict(modelo_logit_full, newdata=testData, type="response")
pred_class_full <- ifelse(predicciones_full > 0.5, 1, 0)
# Evaluación
library(caret)
confusionMatrix(as.factor(pred_class_full), testData$Class)
